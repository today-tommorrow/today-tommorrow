                    "unknown"
                  ]
                },
                "delivery_mode": {
                  "type": "string",
                  "enum": [
                    "online",
                    "offline",
                    "hybrid",
                    "any",
                    "unknown"
                  ]
                },
                "commute_region": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "budget_status": {
                  "type": "string",
