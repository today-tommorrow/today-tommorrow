                  "type": "string",
                  "enum": [
                    "soon",
                    "one_to_three_months",
                    "browse",
                    "unknown"
                  ]
                },
                "document_decision": {
                  "type": "string",
                  "enum": [
                    "provided",
                    "none"
                  ]
                },
                "goal_text": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 2000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "constraints_text": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 2000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "interest_activity": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [],
              "additionalProperties": false,
              "description": "내부 모델 계약. primary target_slot과 서버가 허용한 companion slot만 포함. 선택 문구에 드러나지 않은 값, 이미 확정된 값, 서버 상태 필드 수정 금지. 클라이언트는 이 patch를 제출하지 않는다."
            }
          },
          "required": [
            "key",
            "label",
            "description",
            "answer_patch"
          ],
          "additionalProperties": false
