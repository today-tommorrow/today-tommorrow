  "server_contract": [
    "Validate schema, enum, bounds, unique option keys, eligible target and allowed companion slots.",
    "Acknowledgement can cite only confirmed facts; no statement that unread files have been analyzed.",
    "Every selectable patch must set its target slot to a resolved value, including explicit unknown; reject no-op patches.",
    "Labels and companion values must express the same choice; use conservative companion extraction and evaluate semantic alignment separately.",
    "Assign question/option UUIDs only after validation and persist exact option-to-patch binding before rendering.",
    "Append a server-owned explicit-unknown choice where allowed; direct input remains a separate optional affordance.",
    "Selecting an option submits only expected_revision and selected_option_id.",
    "Never accept client-supplied patches or let Gemma mark intake complete.",
    "Same context reuses a question; stale revision/hash rejects answer with 409.",
    "On generation failure: retry once as initial proposal; then visibly labelled standard questions may continue input. This never replaces failed recommendation inference."
  ],
  "defaults_proposed": {
    "options_min": 2,
    "options_max": 5,
    "selection_mode": "single",
    "generation_repair_attempts": 1,
    "gpu_concurrency": 1,
    "total_question_count": "coverage-based, not fixed at three"
  }
}