#!/bin/sh
# Bootstrap with uv so Python does not need to be installed or selected on PATH.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
action=$1
IFS= read -r pin < "$root/.python-version"
if ! command -v uv >/dev/null 2>&1; then
    echo "오류: uv가 필요합니다. uv를 설치하고 PATH에서 사용할 수 있게 한 뒤 ./setup을 다시 실행해주세요." >&2
    exit 1
fi
python=$(uv python find --no-project --system --no-python-downloads "${pin}" 2>/dev/null) || python=
if [ -z "$python" ]; then
    if [ "$action" != setup ]; then
        echo "오류: Python ${pin}을 찾을 수 없습니다. 먼저 저장소의 ./setup을 실행해주세요." >&2
        exit 1
    fi
    echo "Python ${pin} 준비 중 (uv 관리 설치, 시스템 기본값은 변경하지 않습니다)…"
    if ! uv python install --no-bin "${pin}"; then
        echo "오류: Python ${pin} 설치 실패. 인터넷·프록시와 uv 버전을 확인한 뒤 ./setup을 다시 실행해주세요." >&2
        exit 1
    fi
    python=$(uv python find --no-project --system --no-python-downloads "${pin}" 2>/dev/null) || python=
    if [ -z "$python" ]; then
        echo "오류: 설치한 Python ${pin}을 찾지 못했습니다. uv 설정을 확인한 뒤 ./setup을 다시 실행해주세요." >&2
        exit 1
    fi
fi
exec "$python" "$root/scripts/local.py" "$action"
