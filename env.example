# Local development only; do not use these defaults on a shared server.
POSTGRES_USER=today_bootstrap
POSTGRES_PASSWORD=localdev
POSTGRES_DB=work24_dev
DB_PORT=55432
# Runtime: writes today_app business tables and only reads work24_bge.
DATABASE_URL=postgresql+psycopg://today_app:localdev_app@127.0.0.1:55432/work24_dev
# Migration owner for today_app only.
MIGRATION_DATABASE_URL=postgresql+psycopg://today_migrator:localdev_migration@127.0.0.1:55432/work24_dev
# Development bootstrap only. Never use a production DSN here.
CATALOG_DATABASE_URL=postgresql://today_bootstrap:localdev@127.0.0.1:55432/work24_dev
# Vite development proxy target. The /api path is preserved.
API_TARGET=http://127.0.0.1:8000
# Public browser API prefix, loaded from the repository root .env.
# A separate API server needs its full HTTPS address including /api.
# This value is embedded at build time. Never put tokens or secrets here.
VITE_API_BASE_URL=/api
WEB_PORT=5173
# Google local login: both developers open this exact origin, not localhost.
PUBLIC_ORIGIN=http://127.0.0.1:5173
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/auth/google/callback
# Backend only. Fill locally; never use a VITE_ prefix or commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate separately on each PC: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SESSION_SECRET=
# Development defaults: fixed 8-hour session and 10-minute login attempt.
SESSION_TTL_SECONDS=28800
OAUTH_STATE_TTL_SECONDS=600
# Question generation is disabled until both model settings are filled locally.
# The model service must accept the OpenAI-compatible /v1/chat/completions API.
QUESTION_MODEL_BASE_URL=
QUESTION_MODEL_ID=
QUESTION_MODEL_TIMEOUT_SECONDS=60
QUESTION_MODEL_MAX_TOKENS=512
QUESTION_MODEL_MAX_RESPONSE_BYTES=65536
# Recommendation submission requires explicit live model and pinned catalog settings.
# These server-only values are also required by app.recommendations.worker.
RECOMMENDATION_MODEL_BASE_URL=
RECOMMENDATION_MODEL_ID=
RECOMMENDATION_MODEL_REVISION=
RECOMMENDATION_EMBEDDING_BASE_URL=
CATALOG_PROFILE_ID=
CATALOG_DATASET_ID=
RECOMMENDATION_MODEL_TIMEOUT_SECONDS=60
RECOMMENDATION_MODEL_MAX_TOKENS=2048
RECOMMENDATION_MODEL_MAX_RESPONSE_BYTES=131072
RECOMMENDATION_EMBEDDING_TIMEOUT_SECONDS=30
# Worker settings. The API launcher and documented uv --env-file Worker command
# load this repository-root .env; the Python Worker module does not load it itself.
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=1

# Read-only Work24 detail/compare API. Pin the reviewed source package explicitly.
# No BGE/Gemma URL, inference or new embedding is needed for these routes.
CATALOG_PROFILE_ID=
CATALOG_DATASET_ID=
CATALOG_MANIFEST_SHA256=
