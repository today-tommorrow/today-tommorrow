# Local development only; do not use these defaults on a shared server.
POSTGRES_USER=today_bootstrap
POSTGRES_PASSWORD=localdev
POSTGRES_DB=work24_dev
DB_PORT=55432
# Runtime: writes today_app business tables and only reads work24_bge.
DATABASE_URL=postgresql+psycopg://today_app:localdev_app@127.0.0.1:55432/work24_dev
# Migration owner for today_app only.
MIGRATION_DATABASE_URL=postgresql+psycopg://today_migrator:localdev_migration@127.0.0.1:55432/work24_dev
# Development bootstrap only. Never use a production DSN here.
CATALOG_DATABASE_URL=postgresql://today_bootstrap:localdev@127.0.0.1:55432/work24_dev
# Vite development proxy target. The /api path is preserved.
API_TARGET=http://127.0.0.1:8000
# Public browser API prefix, loaded from the repository root .env.
# A separate API server needs its full HTTPS address including /api.
# This value is embedded at build time. Never put tokens or secrets here.
VITE_API_BASE_URL=/api
WEB_PORT=5173
