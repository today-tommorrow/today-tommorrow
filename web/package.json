{
  "name": "today-tommorrow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json package.json eslint.config.js .prettierrc.json",
    "test": "vitest run --environment jsdom"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "eslint": "^10.14.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "vitest": "^5.0.5",
    "jsdom": "^26.0.0",
    "@testing-library/react": "^16.0.0"
  }
}
